// VS Code reads this file as JSON with comments.
//
// The Airflow configurations stop only in your own code (justMyCode: true).
// To step into Airflow's own code, set "justMyCode": false. That makes the
// debugger trace every line of Airflow and the DAG file import much slower,
// so also raise AIRFLOW__CORE__DAGBAG_IMPORT_TIMEOUT (seconds) in "env".
// Airflow's default is 30; past it the run fails with "Process timed out".
{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "python": "/opt/venv/bin/python"
        },
        {
            "name": "Airflow: Test Task",
            "type": "debugpy",
            "request": "launch",
            "program": "/opt/venv/bin/airflow",
            "args": ["tasks", "test", "${input:dagId}", "${input:taskId}", "${input:logicalDate}"],
            "console": "integratedTerminal",
            "justMyCode": true,
            "python": "/opt/venv/bin/python",
            "env": { "AIRFLOW__CORE__DAGBAG_IMPORT_TIMEOUT": "120" }
        },
        {
            "name": "Airflow: Test DAG",
            "type": "debugpy",
            "request": "launch",
            "program": "/opt/venv/bin/airflow",
            "args": ["dags", "test", "${input:dagId}", "${input:logicalDate}"],
            "console": "integratedTerminal",
            "justMyCode": true,
            "python": "/opt/venv/bin/python",
            "env": { "AIRFLOW__CORE__DAGBAG_IMPORT_TIMEOUT": "120" }
        }
    ],
    "inputs": [
        {"id": "dagId", "type": "promptString", "description": "DAG ID", "default": "my_first_dag"},
        {"id": "taskId", "type": "promptString", "description": "Task ID", "default": "python_task"},
        {"id": "logicalDate", "type": "promptString", "description": "Logical date (YYYY-MM-DD)", "default": "2026-01-01"}
    ]
}
