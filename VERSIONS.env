# ---------------------------------------------------------------------------
# VERSIONS.env — single source of truth for every pinned component.
#
# Sourced by scripts/build-image.sh and scripts/deploy.sh. Change a version
# here, rebuild, and promote the resulting digest; never edit a pin in two
# places.
# ---------------------------------------------------------------------------

# Apache Airflow. Installed with the matching official constraints file:
#   https://raw.githubusercontent.com/apache/airflow/constraints-${AIRFLOW_VERSION}/constraints-${PYTHON_VERSION}.txt
AIRFLOW_VERSION=3.3.2

# Python minor version used for the workspace venv and the constraints file.
# Airflow 3.3.2 publishes constraints for 3.10, 3.11, 3.12 and 3.13.
PYTHON_VERSION=3.12

# Debian-slim base tag for the workspace image.
BASE_IMAGE=python:3.12-slim-bookworm

# code-server (VS Code in the browser).
CODE_SERVER_VERSION=4.138.0

# Zero to JupyterHub Helm chart. appVersion 5.5.2 ships oauthenticator 17.4.0,
# which is what the OIDC config in charts/airflow-dev-platform/values.yaml uses.
Z2JH_CHART_VERSION=4.4.2

# --- AWS (EKS) -------------------------------------------------------------
# Used by docs/aws-setup.md and infra/aws/eksctl-cluster.yaml. Chart versions
# were taken from `helm search repo --versions` on the upstream repos.

# Kubernetes version of the EKS control plane. Keep it within one minor of the
# Cluster Autoscaler's app version (the chart below ships 1.35.x).
EKS_KUBERNETES_VERSION=1.35

# AWS Load Balancer Controller (provisions the ALB). Repo: https://aws.github.io/eks-charts
AWS_LB_CONTROLLER_CHART_VERSION=3.6.0

# Cluster Autoscaler (scales the workspaces node group, including from zero).
# Repo: https://kubernetes.github.io/autoscaler
CLUSTER_AUTOSCALER_CHART_VERSION=9.59.0
